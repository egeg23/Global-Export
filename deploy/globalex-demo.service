# Демонстрационная площадка прототипа Global Export.
#
#   sudo cp deploy/globalex-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now globalex-demo
#   systemctl status globalex-demo
#
# Приложение работает от отдельного системного пользователя `globalex` без
# оболочки и без прав sudo. Он же владеет каталогом, поэтому сборка и служба не
# спорят за право писать в .next.
#
# На сервере, где рядом крутятся другие проекты, это не формальность: публично
# доступное Node-приложение не должно иметь доступа ни к чему, кроме своего
# каталога.
#
# Переменные окружения лежат в /srv/globalex/.env.local — там же ключи
# Supabase и порт службы. Файл не в репозитории и не должен туда попадать.
#
# После правки юнита:
#
#   sudo cp deploy/globalex-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart globalex-demo

[Unit]
Description=Global Export prototype (Next.js)
After=network.target

[Service]
Type=simple
User=globalex
Group=globalex
WorkingDirectory=/srv/globalex
Environment=NODE_ENV=production
# Запасное значение: настоящий порт задаётся в .env.local, и он побеждает —
# EnvironmentFile подключается ниже и переопределяет всё, что объявлено выше.
Environment=PORT=3210
EnvironmentFile=/srv/globalex/.env.local
# Адрес прослушивания задаётся только флагом: переменной окружения для него у
# `next start` нет, и без -H приложение слушает 0.0.0.0, то есть открыто по
# своему порту в обход nginx и сертификата.
ExecStart=/srv/globalex/node_modules/.bin/next start -H 127.0.0.1
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

# Приложение читает только свой каталог и пишет только в .next.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
