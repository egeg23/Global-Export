# Демонстрационная площадка прототипа Global Export.
#
#   sudo cp deploy/globalex-demo.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now globalex-demo
#   systemctl status globalex-demo
#
# Пользователя подставляет команда установки — приложение должно работать от
# того же, кто владеет каталогом, иначе сборка и служба будут драться за права:
#
#   sudo sed "s|^User=.*|User=$USER|" deploy/globalex-demo.service \
#     | sudo tee /etc/systemd/system/globalex-demo.service >/dev/null
#
# Переменные окружения лежат в /srv/globalex/.env.local — там же ключи
# Supabase. Файл не в репозитории и не должен туда попадать.
#
# NoNewPrivileges=true ниже снимает вопрос к тому, что пользователь с правом
# sudo запускает службу: из самой службы повысить права уже нельзя.

[Unit]
Description=Global Export prototype (Next.js)
After=network.target

[Service]
Type=simple
User=CHANGE-ME
WorkingDirectory=/srv/globalex
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/srv/globalex/.env.local
ExecStart=/srv/globalex/node_modules/.bin/next start
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

# Приложение читает только свой каталог и пишет только в .next.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
