#!/usr/bin/env bash
# Обёртка для автоматической выкатки.
#
#   sudo cp deploy/globalex-deploy /usr/local/sbin/globalex-deploy
#   sudo chmod 755 /usr/local/sbin/globalex-deploy
#
# Существует ради одной строки в sudoers: пользователь выкатки получает право
# запустить от root ровно этот файл, а не bash с произвольными аргументами.
#
#   deploy ALL=(root) NOPASSWD: /usr/local/sbin/globalex-deploy
#
# Единственный аргумент — ветка. Она приходит из GitHub Actions и попадает в
# команду удалённой оболочки, поэтому проверяется здесь ещё раз: git разрешает
# в именах веток кавычки и пробелы, sudoers к именам аргументов равнодушен.
set -euo pipefail

branch="${1:-}"

case "$branch" in
  '' | *[!A-Za-z0-9._/-]*)
    echo "✗ Недопустимое имя ветки: ${branch:-<пусто>}"
    exit 2
    ;;
esac

exec env BRANCH="$branch" bash /srv/globalex/deploy/deploy.sh
