# Copy to .env.local and fill in. None of these are required to run the site
# locally — without them the contact form logs submissions to the console
# instead of delivering them (and refuses to start silently dropping leads in
# production).

# Canonical origin, used for sitemap.xml, robots.txt, canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.globalex.uz

# Telegram delivery for contact-form submissions.
# 1. Create a bot with @BotFather and copy the token.
# 2. Add the bot to the group that should receive enquiries.
# 3. Get the chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Канонический адрес сайта ADAR — он уходит в canonical, Open Graph, карту
# сайта и разметку для поиска. На нашей площадке значения не имеет: там раздел
# закрыт от индексации. На сервере заказчика — это его домен.
ADAR_SITE_URL=https://adar.uz

# Куда падают заявки витрины ADAR (/adar/premium): корзина и форма на
# странице контактов. Если не задан — берётся TELEGRAM_CHAT_ID выше, так что
# для одного общего чата достаточно токена и одного id.
ADAR_TELEGRAM_CHAT_ID=

# Optional Bitrix24 hand-off. Create an inbound webhook with crm.lead.add
# permission and paste its base URL, e.g.
# https://yourcompany.bitrix24.ru/rest/1/abcdef123456/
BITRIX_WEBHOOK_URL=

# Demo deployments only. With no delivery channel configured, a production
# build rejects submissions rather than dropping them silently; set this to
# "true" on a preview deployment so the form still completes for a
# walkthrough. Never set it on the live site.
LEAD_ALLOW_UNCONFIGURED=

# Supabase — the content database behind the admin panel at /admin.
# Without these the site serves the content bundled in `content/` and the panel
# reports that it is not connected; the build still succeeds.
# Project settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo deployments only ("true"). The root serves the showcase at /present, and
# the admin panel opens with no login at all — the server signs the request in
# with the shared demo account below. Never set it on the company's site.
#
# Тот же признак убирает с вариантов ADAR витринную обвязку — полосу «все
# варианты» и смету: они наши, а не заказчика. Переменной нет — страницы
# собираются чистыми, так что на чужом сервере ничего не всплывёт по забывчивости.
SHOWCASE_ROOT=

# The account that showcase deployment signs in as. Optional: it defaults to
# demo@globalex.uz / demo, the account created when the showcase was set up.
# Writing to the database is only allowed for a user on the admin list, which
# is why an open panel still needs one.
SHOWCASE_DEMO_EMAIL=
SHOWCASE_DEMO_PASSWORD=

# Код доступа к витрине MAVERA (/mavera). Без строки действует встроенный код,
# «off» открывает витрину всем. Ссылка заказчику: /mavera?key=КОД — она ставит
# куки на 60 дней и убирает ключ из адреса. Смена кода отзывает старые куки.
SHOWCASE_ACCESS_CODE=

# То же самое для макета Golden House (/gh), но код и куки свои: ссылка,
# отданная одному застройщику, не должна открывать макет другого. Ссылка
# заказчику: /gh?key=КОД. Без строки действует встроенный код, «off» открывает
# макет всем.
GH_ACCESS_CODE=

# Бриф из конструктора (кнопка «Отправить бриф» в доке у MAVERA, ADAR и
# концепций Global Export). Основной путь — студия: devuz.studio/api/brief
# заводит заявку, шлёт её в Telegram и даёт клиенту ссылку на бота с
# ассистентом. Секрет — та же строка, что SHOWCASE_BRIEF_SECRET в .env
# devuz.studio. Сгенерировать: openssl rand -hex 24. Пусто — бриф уходит
# в Telegram отсюда, без ассистента.
SHOWCASE_BRIEF_SECRET=
# Адрес студии, если не devuz.studio.
# SHOWCASE_BRIEF_URL=https://devuz.studio/api/brief
# Запасной путь (студия не настроена или не ответила): бриф дороже $10 000
# уходит только в этот чат, дешевле — в TELEGRAM_CHAT_ID. Пусто — крупный
# бриф тоже падает в TELEGRAM_CHAT_ID с пометкой.
SHOWCASE_OWNER_CHAT_ID=
